---
interface Props {
  path: string;
  title: string;
}

const { title, path } = Astro.props;

import "@fontsource/poppins";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Groom is a service and product marketplace allowing shops and service providers to list their services & products. Customers to search for services. Join today!"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#6232c2" />
    <title>{title}</title>
  </head>
  <body>
    <Header path={path} />
    <slot />
    <Footer />
  </body>
</html>
<style is:global>
  @import "@glidejs/glide/dist/css/glide.core.min.css";
  @import "@glidejs/glide/dist/css/glide.theme.min.css";

  * {
    box-sizing: border-box;
  }
  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }
  html {
    font-family: poppins, system-ui, sans-serif;
    scroll-behavior: smooth;
    overflow-x: hidden;
  }
  body {
    overflow-x: hidden;
    position: relative;
  }
</style>
