---
interface Props {
  path: string;
}

const { path } = Astro.props;
---

<header class="flex justify-center">
  <nav
    class="flex items-center justify-between flex-wra p-6 container relative"
  >
    {
      path !== "tester" && (
        <Fragment>
          <div id="box1" class="hidden lg:block absolute -z-50" />
          <div id="box2" class="block lg:hidden absolute -z-50" />
        </Fragment>
      )
    }

    {path === "tester" && <div id="box2" class="block absolute -z-50" />}
    <a href="/" class="flex items-center flex-shrink-0 text-white mr-6">
      <img src="/grom-logo.png" alt="" width="50" height="50" />
      <span
        class=`font-semibold text-xl tracking-tight ${path === 'tester' ? 'text-white' : 'text-white sm:text-black text-violet-700'}`
        >Groom</span
      >
    </a>
    <div class="hidden lg:block">
      <a
        href="https://drive.google.com/file/d/1DBnLgn6KKSGJYK8ArvuEbYSN8Szg7Cuw/view?usp=sharing"
        target="_blank"
        class="inline-block text-sm px-6 py-4 leading-none rounded-md shadow-md text-white bg-[#9368E9] mt-4 lg:mt-0"
        >Download</a
      >
    </div>
    <div class="hidden md:flex lg:items-center justify-end">
      <div class="text-md">
        <a
          href="/"
          class="block mt-4 md:inline-block lg:mt-0 text-white hover:text-white mr-10"
        >
          Home
        </a>
        <a
          href="/tester"
          class="block mt-4 md:inline-block lg:mt-0 text-white hover:text-white mr-10"
        >
          Become a Tester!
        </a>
        <a
          href="/donate"
          class="block mt-4 md:inline-block lg:mt-0 text-white hover:text-white mr-10"
        >
          Donate
        </a>
        <a
          href="#contact"
          class="block mt-4 md:inline-block lg:mt-0 text-white hover:text-white"
        >
          Contact
        </a>
      </div>
    </div>
    <div id="menuToggle" class="sm:hidden">
      <!--
      A fake / hidden checkbox is used as click reciever,
      so you can use the :checked selector on it.
      -->
      <input
        id="checkbox"
        type="checkbox"
        aria-label="Toggle navigation menu"
      />

      <!--
      Some spans to act as a hamburger.
      
      They are acting like a real hamburger,
      not that McDonalds stuff.
      -->
      <span></span>
      <span></span>
      <span></span>

      <!--
      Too bad the menu has to be inside of the button
      but hey, it's pure CSS magic.
      -->
      <ul id="menu">
        <li class=`${path === 'home' ? 'current' : null}`>
          <a href="/">Home</a>
        </li>
        <li class=`${path === 'tester' ? 'current' : null}`>
          <a href="/tester">Become a Tester!</a>
        </li>
        <li class=`${path === 'donate' ? 'current' : null}`>
          <a href="/donate">Donate</a>
        </li>
        <li id="contactlink"><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </nav>
</header>
<style>
  #box1 {
    height: 1520px;
    width: 1920px;
    background: linear-gradient(306.44deg, #433a85 0%, #732ee4 100%);
    border-radius: 120px;
    transform-origin: -10% 38%;
    top: -457px;
    left: 409px;
    rotate: -38deg;
  }

  #box2 {
    height: 1520px;
    width: 1920px;
    background: linear-gradient(306.44deg, #433a85 0%, #732ee4 100%);
    border-radius: 120px;
    transform-origin: -20% 85%;
    top: -1009px;
    left: -109px;
    rotate: -13.5deg;

    @media (max-width: 1024px) {
      transform-origin: -270% 50%;
      rotate: -4deg;
    }
  }

  #menuToggle {
    position: relative;
    top: 0px;
    left: 0px;
    padding:;

    z-index: 1;

    -webkit-user-select: none;
    user-select: none;
  }

  #menuToggle a {
    text-decoration: none;
    color: #fff;

    transition: color 0.3s ease;
  }

  #menuToggle a:hover {
    color: #fff;
  }

  #menuToggle input {
    display: block;
    width: 40px;
    height: 32px;
    position: absolute;
    top: -7px;
    left: -5px;

    cursor: pointer;

    opacity: 0; /* hide this */
    z-index: 2; /* and place it over the hamburger */

    -webkit-touch-callout: none;
  }

  /*
 * Just a quick hamburger
 */
  #menuToggle span {
    display: block;
    width: 33px;
    height: 4px;
    margin-bottom: 5px;
    position: relative;

    background: #fff;
    border-radius: 3px;

    z-index: 1;

    transform-origin: 4px 0px;

    transition:
      transform 0.5s cubic-bezier(0.77, 0.2, 0.05, 1),
      background 0.5s cubic-bezier(0.77, 0.2, 0.05, 1),
      opacity 0.55s ease;
  }

  #menuToggle span:first-child {
    transform-origin: 0% 0%;
  }

  #menuToggle span:nth-last-child(2) {
    transform-origin: 0% 100%;
  }

  /* 
 * Transform all the slices of hamburger
 * into a crossmark.
 */
  #menuToggle input:checked ~ span {
    opacity: 1;
    transform: rotate(45deg) translate(-2px, -1px);
    background: #fff;
  }

  /*
 * But let's hide the middle one.
 */
  #menuToggle input:checked ~ span:nth-last-child(3) {
    opacity: 0;
    transform: rotate(0deg) scale(0.2, 0.2);
  }

  /*
 * Ohyeah and the last one should go the other direction
 */
  #menuToggle input:checked ~ span:nth-last-child(2) {
    transform: rotate(-45deg) translate(0, -1px);
  }

  /*
 * Make this absolute positioned
 * at the top left of the screen
 */
  #menu {
    position: absolute;
    width: 100vw;
    height: 100vh;
    top: -40px;
    right: -24px;
    padding: 50px;
    padding-top: 125px;

    background: linear-gradient(to right, #6232c2, #4b3895);
    list-style-type: none;
    -webkit-font-smoothing: antialiased;
    /* to stop flickering of text in safari */

    transform-origin: 100% 100%;
    transform: translate(100%, 0%);

    transition: transform 0.5s cubic-bezier(0.77, 0.2, 0.05, 1);
  }

  #menu li {
    padding: 2px 10px;
    font-size: 22px;
    margin-bottom: 20px;
    border-left: 4px solid transparent;
  }

  #menu li a {
    display: block;
  }

  #menu .current {
    border-left: 4px solid white;
  }

  /*
 * And let's slide it in from the left
 */
  #menuToggle input:checked ~ ul {
    transform: none;
  }
</style>
<script>
  let html = document.querySelector("html");
  let checkbox = document.getElementById("checkbox") as HTMLInputElement;
  let contactlink = document.getElementById("contactlink") as HTMLInputElement;

  checkbox.addEventListener("change", () => {
    if (checkbox.checked) {
      // Hidde vertical scroll
      html.style.overflowY = "hidden";
    } else {
      // Show vertical scroll
      html.style.overflowY = "scroll";
    }
  });

  contactlink.addEventListener("click", () => {
    checkbox.checked = false;
    html.style.overflowY = "scroll";
  });
</script>
