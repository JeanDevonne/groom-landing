<section class="flex justify-center bg-[#fff]">
  <div class="container py-20 sm:py-28 px-10">
    <div class="flex flex-col items-center mb-16">
      <p class="text-[32px] sm:text-[48px] font-bold text-center">
        Problems Groom Will Solve
      </p>
      <div class="w-20 h-1 bg-[#7C4FE0] mt-2 mb-2"></div>
    </div>
    <div class="flex justify-center">
      <div id="review" class="glide max-w-[1400px]">
        <div class="glide__track" data-glide-el="track">
          <ul class="glide__slides text-center">
            <li class="glide__slide">
              <p class="font-bold text-[20px]">Miah</p>
              <p class="my-2">Lost Deposits</p>
              <p>
                It’s really sad that ppl are lying about being hair stylist just
                to take a $25 deposit. If your reading this and that’s you
                please stop. It’s a terrible thing to do.
              </p>
            </li>
            <li class="glide__slide">
              <p class="font-bold text-[20px]">Matt</p>
              <p class="my-2">Shop Reviews</p>
              <p>
                I tried this place because of the amazing reviews I read about
                Yolanda and Lolita. I found out that they both left the shop
                weeks ago. Ok style and experience, but I was disappointed.
              </p>
            </li>
            <li class="glide__slide">
              <p class="font-bold text-[20px]">Hope</p>
              <p class="my-2">Random Social Media</p>
              <p>I need my hair done sooo bad <br />BRAIDERS TAP IN</p>
            </li>
          </ul>
        </div>

        <div class="glide__bullets" data-glide-el="controls[nav]">
          <button class="glide__bullet" data-glide-dir="=0"></button>
          <button class="glide__bullet" data-glide-dir="=1"></button>
          <button class="glide__bullet" data-glide-dir="=2"></button>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .glide__bullets {
    bottom: -3em;
  }
  .glide__bullet {
    background-color: #c8c8c8;
    box-shadow: none;
    height: 12px;
    width: 12px;
    margin: 8px;
  }
  .glide__bullet--active {
    background-color: #7c4fe0;
  }
  .glide__bullet--active {
    box-shadow: 0 0 0.4em 0 #7c4fe0;
  }
</style>
<script>
  import Glide from "@glidejs/glide/dist/glide.min.js";
  var glide = new Glide("#review", {
    type: "carousel",
    startAt: 1,
    perView: 1,
    focusAt: "center",
    gap: 40,
    peek: 360,
    breakpoints: {
      1280: {
        perView: 1,
        peek: 320,
        gap: 100,
      },
      1024: {
        perView: 1,
        peek: 50,
        gap: 50,
      },
    },
  });

  // Initialize on first load
  glide.mount();
</script>
