                d="M14.8751 0.10096L0.390677 8.45721C-0.174948 8.78221 -0.103073 9.56971 0.459427 9.80721L3.7813 11.201L12.7594 3.28846C12.9313 3.13534 13.1751 3.36971 13.0282 3.54784L5.50005 12.7197V15.2353C5.50005 15.9728 6.39068 16.2635 6.82818 15.7291L8.81255 13.3135L12.7063 14.9447C13.1501 15.1322 13.6563 14.8541 13.7376 14.376L15.9876 0.87596C16.0938 0.24471 15.4157 -0.21154 14.8751 0.10096Z"
