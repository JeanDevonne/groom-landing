                fill="white"></path>
            </svg>
          </div>
          <p class="ml-4">admin@joingroom.com</p>
        </div>
      </div>
      <div class="w-[90%] sm:w-1/2">
        <form id="FeedbackForm">
          <input
            type="text"
            name="name"
            id="name"
            class="text-sm block w-full p-4 outline-1 outline-indigo-500 border shadow-[0px_5px_10px_0px_#0000001f] mb-2 mx-auto"
            placeholder="Name"
            required
          />
          <span class="error" id="nameError"
            >The name must only contain letters and spaces.</span
          >
          <input
            type="email"
            name="email"
            id="email"
            class="text-sm block w-full p-4 outline-1 outline-indigo-500 border shadow-[0px_5px_10px_0px_#0000001f] mt-6 mb-2 mx-auto"
            placeholder="Email"
            required
          />
          <span class="error" id="emailError"
            >Please enter a valid email address.</span
          >
          <input
            type="text"
            name="subject"
            id="subject"
            class="text-sm block w-full p-4 outline-1 outline-indigo-500 border shadow-[0px_5px_10px_0px_#0000001f] mt-6 mb-2 mx-auto"
            placeholder="Subject: Improvement Suggestion"
            required
          />
          <span class="error text-red-500" id="subjectError"
            >The subject cannot be empty.</span
          >
          <textarea
            name="details"
            id="details"
            aria-label="Enter your message"
            class="w-full p-4 outline-1 outline-indigo-500 border shadow-[0px_5px_10px_0px_#0000001f] mt-6 mb-2"
            rows="4"></textarea>
          <span class="error" id="detailsError"
            >Details must be at least 10 characters.</span
          >
          <button
            id="submitBtn"
            class="w-full flex justify-center items-center bg-[#7C4FE0] disabled:bg-gray-300 text-white p-6 rounded-md mt-6 mb-2"
            disabled
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
