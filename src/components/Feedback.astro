    </div>
  </div>
  <dialog id="feedbackDialog" class="p-10 rounded-lg">
    <div class="max-w-md">
      <h3 class="text-lg font-bold">We appreciate your input!</h3>
      <p class="py-4">
        Your feedback has been received and will help us improve our service.
        Thank you for taking the time to share your thoughts!
      </p>
      <div class="flex justify-end">
        <form method="dialog">
          <!-- if there is a button in form, it will close the modal -->
          <button class="bg-slate-200 px-4 py-2 rounded-md">Close</button>
        </form>
      </div>
    </div>
  </dialog>
</section>
<style>
  .error {
    display: none;
    color: #ce0000bb;
    font-size: 12px;
  }
</style>
<script>
  const scriptURL =
    "https://script.google.com/macros/s/AKfycbwBVa1lYqs_j7SewH0jPr1h6m6M_cqlp-GmLFtOFJ-lICLn9VQXwNgc37qHNs6QS4G7/exec";

  let FeedbackDialog = document.getElementById(
    "feedbackDialog"
  ) as HTMLDialogElement;
  let FeedbackForm = document.getElementById("FeedbackForm") as HTMLFormElement;
  FeedbackForm.addEventListener("submit", (e) => {
    e.preventDefault();
    submitBtn.disabled = true;

    const formData = {
      name: (document.getElementById("name") as HTMLInputElement).value,
      email: (document.getElementById("email") as HTMLInputElement).value,
      subject: (document.getElementById("subject") as HTMLInputElement).value,
      details: (document.getElementById("details") as HTMLInputElement).value,
    };

    fetch(scriptURL, {
      method: "POST",
      body: JSON.stringify(formData),
      headers: { "Content-Type": "application/json" },
      mode: "no-cors",
    })
      .then((response) => response.text())
      .then((responseText) => {
        console.log(responseText);
        FeedbackForm.reset();
        // alert(responseText);
        FeedbackDialog.showModal();
      })
      .catch((error) => console.error("Error:", error));
  });

  // Seleccionar los elementos del formulario
  const nameInput = document.getElementById("name") as HTMLInputElement;
  const emailInput = document.getElementById("email") as HTMLInputElement;
  const subjectInput = document.getElementById("subject") as HTMLInputElement;
  const detailsInput = document.getElementById("details") as HTMLInputElement;
  const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;

  // Seleccionar los elementos de error
  const nameError = document.getElementById("nameError");
  const emailError = document.getElementById("emailError");
  const subjectError = document.getElementById("subjectError");
  const detailsError = document.getElementById("detailsError");

  // Expresiones regulares para validaciones
  const nameRegex = /^[a-zA-Z\s]+$/; // Solo letras y espacios
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/; // Formato básico de correo electrónico

  // Función para verificar si todos los campos son válidos
  function validateForm() {
    const isNameValid = nameRegex.test(nameInput.value.trim());
    const isEmailValid = emailRegex.test(emailInput.value.trim());
    const isSubjectValid = subjectInput.value.trim() !== "";
    const isDetailsValid = detailsInput.value.trim().length >= 10;

    // Habilitar o deshabilitar el botón de envío
    submitBtn.disabled = !(
      isNameValid &&
      isEmailValid &&
      isSubjectValid &&
      isDetailsValid
    );

    // Añadir o quitar clase 'invalid' según la validación
    nameInput.classList.toggle("border-red-500", !isNameValid);
    emailInput.classList.toggle("border-red-500", !isEmailValid);
    subjectInput.classList.toggle("border-red-500", !isSubjectValid);
    detailsInput.classList.toggle("border-red-500", !isDetailsValid);

    // Mostrar u ocultar mensajes de error
    nameError.style.display = isNameValid ? "none" : "block";
    emailError.style.display = isEmailValid ? "none" : "block";
    subjectError.style.display = isSubjectValid ? "none" : "block";
    detailsError.style.display = isDetailsValid ? "none" : "block";
  }

  // Agregar eventos de entrada a cada campo para validar en tiempo real
  nameInput.addEventListener("input", validateForm);
  emailInput.addEventListener("input", validateForm);
  subjectInput.addEventListener("input", validateForm);
  detailsInput.addEventListener("input", validateForm);
</script>
