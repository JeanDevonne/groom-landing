<section class="flex justify-center bg-[#fff]">
  <div class="container py-10 sm:py-28 px-10">
    <div class="flex flex-col items-center mb-16">
      <p class="text-[32px] sm:text-[48px] font-bold">Groom FAQs</p>
      <div class="w-20 h-1 bg-[#7C4FE0] mt-2 mb-2"></div>
      <p class="max-w-[650px] text-center">
        Thank you for your interest in Groom.
      </p>
    </div>

    <div class="dropdown-container">
      <header class="clearfix">
        <h1>What is Groom?</h1>
        <img class="expand" src="/arrow.png" alt="" />
      </header>
      <article>
        <div class="article-inner">
          <p>
            Groom is a peer-to-peer platform that connects clients with
            independent beauty and wellness service providers. It offers a
            flexible and personalized approach to booking appointments and
            discovering new talent.
          </p>
        </div>
      </article>
    </div>

    <div class="dropdown-container">
      <header class="clearfix">
        <h1>How does Groom work?</h1>
        <img class="expand" src="/arrow.png" alt="" />
      </header>
      <article>
        <div class="article-inner">
          <p>
            Clients post service requests, compare stylists, and book
            appointments. Stylists review requests, send bids, and communicate
            with clients.
          </p>
        </div>
      </article>
    </div>

    <div class="dropdown-container">
      <header class="clearfix">
        <h1>How much does it cost to use Groom?</h1>
        <img class="expand" src="/arrow.png" alt="" />
      </header>
      <article>
        <div class="article-inner">
          <p>
            For clients Groom is free, but we do charge a small fee at
            check-out. For providers pricing varies depending on the length of
            subscription. You can compare prices and find the best deal for you.
          </p>
        </div>
      </article>
    </div>

    <div class="dropdown-container">
      <header class="clearfix">
        <h1>How do I find a stylist near me?</h1>
        <img class="expand" src="/arrow.png" alt="" />
      </header>
      <article>
        <div class="article-inner">
          <p>
            Groom uses your location to find stylists in your area. You can also
            search by specific services or preferences.
          </p>
        </div>
      </article>
    </div>

    <div class="dropdown-container">
      <header class="clearfix">
        <h1>Can I chat with a stylist before booking?</h1>
        <img class="expand" src="/arrow.png" alt="" />
      </header>
      <article>
        <div class="article-inner">
          <p>
            Yes, you can chat with stylists directly through the app to discuss
            your desired look and ask questions.
          </p>
        </div>
      </article>
    </div>

    <div class="dropdown-container">
      <header class="clearfix">
        <h1>How do I post a service request?</h1>
        <img class="expand" src="/arrow.png" alt="" />
      </header>
      <article>
        <div class="article-inner">
          <p>
            Simply describe your desired haircut, beard trim, or styling
            preferences, and Groom will match you with suitable stylists.
          </p>
        </div>
      </article>
    </div>

    <div class="dropdown-container">
      <header class="clearfix">
        <h1>How do I become a provider on Groom?</h1>
        <img class="expand" src="/arrow.png" alt="" />
      </header>
      <article>
        <div class="article-inner">
          <p>
            Visit your client account screen and sign up to become a Groomer.
          </p>
        </div>
      </article>
    </div>

    <div class="dropdown-container">
      <header class="clearfix">
        <h1>Is Groom available on Android?</h1>
        <img class="expand" src="/arrow.png" alt="" />
      </header>
      <article>
        <div class="article-inner">
          <p>
            Yes, Groom is currently available on Android. We plan to release an
            iOS version soon.
          </p>
        </div>
      </article>
    </div>

    <div class="dropdown-container">
      <header class="clearfix">
        <h1>Is my personal information safe on Groom?</h1>
        <img class="expand" src="/arrow.png" alt="" />
      </header>
      <article>
        <div class="article-inner">
          <p>
            Yes, Groom uses secure payment processing and data encryption to
            protect your information.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .clearfix {
    height: 50px;
    position: relative;
  }

  .dropdown-container {
    max-width: 650px;
    min-width: 300px;
    margin: 0rem auto;
    border-bottom: 1px solid #e9e9e9;
    background-color: white;
    color: #888;
    overflow: hidden;
  }

  .dropdown-container {
    background-color: white;
  }

  .dropdown-container header {
    cursor: pointer;
    padding: 0.8rem;
    background-color: #fff;
    color: #000;
    transition: background-color 350ms ease-in-out;
  }

  .dropdown-container.open header {
    background-color: #fff;
  }

  .dropdown-container h1 {
    font-weight: 500;
  }

  .dropdown-container .expand {
    position: absolute;
    top: 18px;
    right: 10px;
    transform: rotate(0deg);
    font-size: 1.8em;
    transition: transform 350ms ease-in-out;
  }

  .dropdown-container.open .expand {
    transform: rotate(90deg);
  }

  .dropdown-container article {
    max-height: 0px;
    overflow: hidden;
    line-height: 1.6;
    transition: max-height 350ms ease-in-out;
  }

  /* padding can't be on article element because it won't collapse properly, add wrapper around contents */
  .dropdown-container .article-inner {
    padding: 1rem;
  }

  @media (max-width: 800px) {
    .clearfix {
      height: auto;
    }
  }
</style>
<script>
  var headers = document.querySelectorAll(".dropdown-container header");

  for (var i = 0; i < headers.length; i++) {
    headers[i].addEventListener("click", openCurrAccordion);
  }

  //Use this as the callback if you would like multiple dropdowns to be open
  function openAccordion(e) {
    var parent = this.parentElement;
    var article = this.nextElementSibling;

    if (!parent.classList.contains("open")) {
      parent.classList.add("open");
      article.style.maxHeight = article.scrollHeight + "px";
    } else {
      parent.classList.remove("open");
      article.style.maxHeight = "0px";
    }
  }

  //Use this as the callback if you would like no more than one dropdown to be open
  function openCurrAccordion(e) {
    for (var i = 0; i < headers.length; i++) {
      var parent = headers[i].parentElement;
      var article = headers[i].nextElementSibling as HTMLElement;

      if (this === headers[i] && !parent.classList.contains("open")) {
        parent.classList.add("open");
        article.style.maxHeight = article.scrollHeight + "px";
      } else {
        parent.classList.remove("open");
        article.style.maxHeight = "0px";
      }
    }
  }

  //Notes:
  /* Adding the 'open' class to the dropdown allows us to create
   * easier stylings for the different components of the dropdown.
   * It basically acts as a way to style based on the state (open/closed).
   * The maxHeight style transition is the base functionality.
   *
   * Change the callback in line 4 to either openCurrAccordion or openAccordion
   * to see the two different behaviors commented above each function
   */

  //More Advanced Notes:
  /* If you had a nav menu with defined heights you could use the checkbox trick
   * common with mobile nav menus. However, height cannot be transitioned so we
   * use max-height. In addition, transitioning max-height to a percentage doesn't
   * function properly, we need to use javascript to find the height and set it as
   * a pixel value. If you have a pre-determined height for your dropdowns, you
   * could implement a version without javascript. Javascript does allow us a
   * little more flexibility in this instance.
   */
</script>
