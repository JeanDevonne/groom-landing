  <dialog id="my_modal_1" class="p-10 rounded-lg">
    <div class="max-w-md">
      <h3 class="text-lg font-bold">Information Saved Successfully!</h3>
      <!-- <h3 class="text-lg font-bold">Payment successful!</h3> -->
      <p class="py-4">
        All your details have been securely recorded. Thank you!
      </p>
      <!-- <p class="py-4">
        Your payment has been processed successfully. Thank you for your
        purchase!
      </p> -->
      <div class="flex justify-end">
        <form method="dialog">
          <!-- if there is a button in form, it will close the modal -->
