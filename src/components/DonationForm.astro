<style>
  .error {
    display: none;
    color: #ce0000bb;
    font-size: 12px;
  }
</style>
<script>
  // Donation Once or Monthly Switch
  let onceDonationBtn = document.getElementById(
    "onceDonationBtn"
  ) as HTMLButtonElement;
  let monthlyDonationBtn = document.getElementById(
    "monthlyDonationBtn"
  ) as HTMLButtonElement;

  let once35 = document.getElementById("once35") as HTMLAnchorElement;
  let once50 = document.getElementById("once50") as HTMLAnchorElement;
  let once100 = document.getElementById("once100") as HTMLAnchorElement;
  let once250 = document.getElementById("once250") as HTMLAnchorElement;
  let once500 = document.getElementById("once500") as HTMLAnchorElement;

  let monthly35 = document.getElementById("monthly35") as HTMLAnchorElement;
  let monthly50 = document.getElementById("monthly50") as HTMLAnchorElement;
  let monthly100 = document.getElementById("monthly100") as HTMLAnchorElement;
  let monthly250 = document.getElementById("monthly250") as HTMLAnchorElement;
  let monthly500 = document.getElementById("monthly500") as HTMLAnchorElement;

  onceDonationBtn.addEventListener("click", () => {
    onceDonationBtn.classList.remove("bg-[#fff]", "text-[#AAA]");
    onceDonationBtn.classList.add("bg-[#5029DE]", "text-[#fff]");
    monthlyDonationBtn.classList.remove("bg-[#5029DE]", "text-[#fff]");
    monthlyDonationBtn.classList.add("bg-[#fff]", "text-[#AAA]");

    once35.classList.remove("hidden");
    once35.classList.add("flex");
    once50.classList.remove("hidden");
    once50.classList.add("flex");
    once100.classList.remove("hidden");
    once100.classList.add("flex");
    once250.classList.remove("hidden");
    once250.classList.add("flex");
    once500.classList.remove("hidden");
    once500.classList.add("flex");

    monthly35.classList.remove("flex");
    monthly35.classList.add("hidden");
    monthly50.classList.remove("flex");
    monthly50.classList.add("hidden");
    monthly100.classList.remove("flex");
    monthly100.classList.add("hidden");
    monthly250.classList.remove("flex");
    monthly250.classList.add("hidden");
    monthly500.classList.remove("flex");
    monthly500.classList.add("hidden");
  });

  monthlyDonationBtn.addEventListener("click", () => {
    onceDonationBtn.classList.remove("bg-[#5029DE]", "text-[#fff]");
    onceDonationBtn.classList.add("bg-[#fff]", "text-[#AAA]");
    monthlyDonationBtn.classList.remove("bg-[#fff]", "text-[#AAA]");
    monthlyDonationBtn.classList.add("bg-[#5029DE]", "text-[#fff]");

    once35.classList.remove("flex");
    once35.classList.add("hidden");
    once50.classList.remove("flex");
    once50.classList.add("hidden");
    once100.classList.remove("flex");
    once100.classList.add("hidden");
    once250.classList.remove("flex");
    once250.classList.add("hidden");
    once500.classList.remove("flex");
    once500.classList.add("hidden");

    monthly35.classList.remove("hidden");
    monthly35.classList.add("flex");
    monthly50.classList.remove("hidden");
    monthly50.classList.add("flex");
    monthly100.classList.remove("hidden");
    monthly100.classList.add("flex");
    monthly250.classList.remove("hidden");
    monthly250.classList.add("flex");
    monthly500.classList.remove("hidden");
    monthly500.classList.add("flex");
  });

  const scriptURL =
    "https://script.google.com/macros/s/AKfycbzeFruLqejaNXUDjaPa0iWAit2GgC9XUSHjtEWHXO3jz7lBie9QOj0HaNJ_mKn3xU4n/exec";

  let my_modal_1 = document.getElementById("my_modal_1") as HTMLDialogElement;
  let donationForm = document.getElementById("donationForm") as HTMLFormElement;
  donationForm.addEventListener("submit", (e) => {
    e.preventDefault();
    submitDonationBtn.disabled = true;
    submitDonationBtn.innerText = "Sending Information...";

    const formData = {
      firstName: (document.getElementById("firstName") as HTMLInputElement)
        .value,
      lastName: (document.getElementById("lastName") as HTMLInputElement).value,
      address: (document.getElementById("address") as HTMLInputElement).value,
      address2: (document.getElementById("address2") as HTMLInputElement).value,
      city: (document.getElementById("city") as HTMLInputElement).value,
      state: (document.getElementById("state") as HTMLInputElement).value,
      zip: (document.getElementById("zip") as HTMLInputElement).value,
      country: (document.getElementById("country") as HTMLInputElement).value,
      email: (document.getElementById("email2") as HTMLInputElement).value,
      paymentMethod: (
        document.getElementById("paymentMethod") as HTMLInputElement
      ).value,
    };

    fetch(scriptURL, {
      method: "POST",
      body: JSON.stringify(formData),
      headers: { "Content-Type": "application/json" },
      mode: "no-cors",
    })
      .then((response) => response.text())
      .then((responseText) => {
        console.log(responseText);
        donationForm.reset();
        submitDonationBtn.innerText = "Submit Information";
        // alert(responseText);
        my_modal_1.showModal();
      })
      .catch((error) => console.error("Error:", error));
  });

  // Seleccionar los elementos del formulario
  const firstNameInput = document.getElementById(
    "firstName"
  ) as HTMLInputElement;
  const lastNameInput = document.getElementById("lastName") as HTMLInputElement;
  const addressInput = document.getElementById("address") as HTMLInputElement;
  const address2Input = document.getElementById("address2") as HTMLInputElement;
  const cityInput = document.getElementById("city") as HTMLInputElement;
  const stateInput = document.getElementById("state") as HTMLSelectElement;
  const zipInput = document.getElementById("zip") as HTMLInputElement;
  const countryInput = document.getElementById("country") as HTMLInputElement;
  const emailInput2 = document.getElementById("email2") as HTMLInputElement;
  const paymentMethodInput = document.getElementById(
    "paymentMethod"
  ) as HTMLInputElement;
  const submitDonationBtn = document.getElementById(
    "submitDonationBtn"
  ) as HTMLButtonElement;

  // Expresiones regulares para validaciones
  const nameRegex = /^[a-zA-Z\s]+$/; // Solo letras y espacios
  const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/; // Formato básico de correo electrónico
  const addressRegex = /^[a-zA-Z0-9\s,.'-]{3,}$/;
  const zipRegex = /^[0-9]{5}(?:-[0-9]{4})?$/;

  // Función para verificar si todos los campos son válidos
  function validateForm() {
    const isFirstNameValid = nameRegex.test(firstNameInput.value.trim());
    const isLastNameValid = nameRegex.test(lastNameInput.value.trim());
    const isAddressValid = addressRegex.test(addressInput.value.trim());
    const isAddress2Valid = addressRegex.test(address2Input.value.trim());
    const isCityValid = nameRegex.test(cityInput.value.trim());
    const isStateValid = nameRegex.test(stateInput.value.trim());
    const isZipValid = zipRegex.test(zipInput.value.trim());
    const isCountryValid = nameRegex.test(countryInput.value.trim());
    const isEmailValid = emailRegex.test(emailInput2.value.trim());
    const isPaymentMethodValid = nameRegex.test(
      paymentMethodInput.value.trim()
    );

    // Habilitar o deshabilitar el botón de envío
    submitDonationBtn.disabled = !(
      isFirstNameValid &&
      isLastNameValid &&
      isAddressValid &&
      isAddress2Valid &&
      isCityValid &&
      isStateValid &&
      isZipValid &&
      isCountryValid &&
      isEmailValid &&
      isPaymentMethodValid
    );

    // Añadir o quitar clase 'invalid' según la validación
    firstNameInput.classList.toggle("border-red-500", !isFirstNameValid);
    lastNameInput.classList.toggle("border-red-500", !isLastNameValid);
    addressInput.classList.toggle("border-red-500", !isAddressValid);
    address2Input.classList.toggle("border-red-500", !isAddress2Valid);
    cityInput.classList.toggle("border-red-500", !isCityValid);
    stateInput.classList.toggle("border-red-500", !isStateValid);
    zipInput.classList.toggle("border-red-500", !isZipValid);
    countryInput.classList.toggle("border-red-500", !isCountryValid);
    emailInput2.classList.toggle("border-red-500", !isEmailValid);
    paymentMethodInput.classList.toggle(
      "border-red-500",
      !isPaymentMethodValid
    );
  }

  // Agregar eventos de entrada a cada campo para validar en tiempo real
  firstNameInput.addEventListener("input", validateForm);
  lastNameInput.addEventListener("input", validateForm);
  addressInput.addEventListener("input", validateForm);
  address2Input.addEventListener("input", validateForm);
  cityInput.addEventListener("input", validateForm);
  stateInput.addEventListener("input", validateForm);
  zipInput.addEventListener("input", validateForm);
  countryInput.addEventListener("input", validateForm);
  emailInput2.addEventListener("input", validateForm);
  paymentMethodInput.addEventListener("input", validateForm);
</script>
