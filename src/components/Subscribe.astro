<section class="flex justify-center bg-[#fff]">
  <div
    class="container py-10 sm:py-14 px-10 hero-pattern bg-cover bg-center bg-[url('/map.png')]"
  >
    <div class="flex flex-col items-center">
      <p class="text-[32px] sm:text-[48px] font-bold text-center">
        Subscribe to get updates
      </p>
      <p class="max-w-[650px] text-center mt-2 mb-6">
        We’ll let you know as we get closer to launch!
      </p>
      <form id="becomeTesterForm" class="flex flex-col items-center">
        <input
          type="text"
          name="emailOrPhone2"
          id="emailOrPhone2"
          class="text-sm block w-[300px] sm:w-[650px] p-5 outline-indigo-500 border shadow-[0px_5px_10px_0px_#0000001f] mb-6 rounded-md text-center"
          placeholder="Enter your phone or email"
          required
        />
        <span class="error" id="emailError2"
          >Please enter a valid email address or phone number.</span
        >
        <button
          id="submitBtn2"
          class="w-[300px] sm:w-[650px] flex justify-center items-center bg-[#7C4FE0] disabled:bg-gray-300 text-white p-4 mt-4 rounded-md"
          disabled
        >
          <p class="ml-4">Subscribe</p>
        </button>
      </form>
    </div>
  </div>
  <dialog id="becomeTesterDialog" class="p-10 rounded-lg">
    <div class="max-w-md">
      <h3 class="text-lg font-bold">Thank You for Becoming a Tester!</h3>
      <p class="py-4">
        We appreciate your willingness to help us improve our product. Your
        insights and feedback are invaluable, and we look forward to working
        with you!
      </p>
      <div class="flex justify-end">
        <form method="dialog">
          <!-- if there is a button in form, it will close the modal -->
          <button class="bg-slate-200 px-4 py-2 rounded-md">Close</button>
        </form>
      </div>
    </div>
  </dialog>
</section>
<style>
  .error {
    display: none;
    color: #ce0000bb;
    font-size: 12px;
  }
</style>
<script>
  const scriptURL =
    "https://script.google.com/macros/s/AKfycbwqLIMKQBRhmZtK64wVUmGf95RVNHp4e-Tdf1tFHkcHqtizNSYENU2DulKTsxfBwRmh/exec";

  let BecomeTesterDialog = document.getElementById(
    "becomeTesterDialog"
  ) as HTMLDialogElement;

  let BecomeTesterForm = document.getElementById(
    "becomeTesterForm"
  ) as HTMLFormElement;

  BecomeTesterForm.addEventListener("submit", (e) => {
    e.preventDefault();
    submitBtn2.disabled = true;
    submitBtn2.innerText = "Subscribing...";

    const formData = {
      emailOrPhone: (
        document.getElementById("emailOrPhone2") as HTMLInputElement
      ).value,
    };

    fetch(scriptURL, {
      method: "POST",
      body: JSON.stringify(formData),
      headers: { "Content-Type": "application/json" },
      mode: "no-cors",
    })
      .then((response) => response.text())
      .then((responseText) => {
        console.log(responseText);
        BecomeTesterForm.reset();
        submitBtn2.innerText = "Subscribe";
        // alert(responseText);
        BecomeTesterDialog.showModal();
      })
      .catch((error) => console.error("Error:", error));
  });

  // Seleccionar los elementos del formulario
  let contactInput2 = document.getElementById(
    "emailOrPhone2"
  ) as HTMLInputElement;
  let submitBtn2 = document.getElementById("submitBtn2") as HTMLButtonElement;

  // Seleccionar los elementos de error
  const emailError2 = document.getElementById("emailError2");

  // Función para validar teléfono o correo
  function validateInput(value) {
    const phoneRegex =
      /^(?:\+1\s?)?(?:\(\d{3}\)|\d{3})(?:[-.\s]?\d{3})(?:[-.\s]?\d{4})$/; // Asume que un teléfono válido es de 10 dígitos
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/; // Formato básico para validar correos
    contactInput2.classList.toggle(
      "border-red-500",
      !(phoneRegex.test(value) || emailRegex.test(value))
    );
    return phoneRegex.test(value) || emailRegex.test(value);
  }

  // Evento para validar y habilitar el botón
  contactInput2.addEventListener("input", () => {
    if (validateInput(contactInput2.value)) {
      submitBtn2.disabled = false;
      emailError2.style.display = "none";
    } else {
      submitBtn2.disabled = true;
      emailError2.style.display = "block";
    }
  });
</script>
