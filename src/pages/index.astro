---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import ProviderFocused from "../components/ProviderFocused.astro";
import ClientFocused from "../components/ClientFocused.astro";
import Feedback from "../components/Feedback.astro";
import Carousell from "../components/Carousell.astro";
import Launch from "../components/Launch.astro";
import Subscribe from "../components/Subscribe.astro";
import Faqs from "../components/Faqs.astro";
---

<Layout title="Home" path="home">
  <main>
    <Hero title="Get Groomed When, Where, How you want." />
    <About />
    <ProviderFocused />
    <ClientFocused />
    <Feedback />
    <Carousell />
    <Launch />
    <Subscribe />
    <Faqs />
  </main>
</Layout>

<style>
  main {
    line-height: 1.6;
  }
</style>
